#!/usr/bin/env bash
# =============================================================================
#  milo — technician CLI for status, raw fixes, database inspection & camera
#
#    milo status | doctor | fix [all|mqtt|hailo|db|reinstall]
#    milo db [tables|<table>|sql "<query>"|shell]
#    milo camera | logs | restart | update | rollback | backup | restore | ui
# =============================================================================
set -uo pipefail

MILO_ROOT="${MILO_ROOT:-/opt/milo}"
cd "${MILO_ROOT}" 2>/dev/null || cd /
CONFIG_FILE="${MILO_ROOT}/data/config.env"
[[ -f "$CONFIG_FILE" ]] && set -a && . "$CONFIG_FILE" 2>/dev/null && set +a

DB="${MILO_DB_PATH:-${MILO_ROOT}/data/recycling_points.db}"
ROLE="${MILO_ROLE:-both}"
MAIN_UNIT="milo-core.service"; [[ "$ROLE" == "edge" ]] && MAIN_UNIT="milo-edge.service"
need_root() { [[ ${EUID} -eq 0 ]] || { echo "This needs sudo:  sudo milo $*" >&2; exit 1; }; }

case "${1:-status}" in
  status)
    systemctl status "$MAIN_UNIT" --no-pager -n 12 2>/dev/null || echo "Not installed."
    ;;

  doctor|health|check)
    exec milo-doctor "${@:2}"
    ;;

  fix|repair)
    need_root fix "${2:-all}"
    TARGET="${2:-all}"
    case "$TARGET" in
      all)
        echo "==> Running full raw self-heal (MQTT + Hailo + Services)..."
        milo-doctor --heal
        systemctl restart mosquitto.service "$MAIN_UNIT" milo-config-ui.service 2>/dev/null || true
        echo "✓ Done. Current status:"
        milo-doctor
        ;;
      mqtt)
        echo "==> Rewriting Mosquitto config, ACLs, and credentials (browser=milo_browser_public)..."
        milo-doctor --heal >/dev/null 2>&1 || true
        systemctl restart mosquitto.service "$MAIN_UNIT"
        echo "✓ Mosquitto and ${MAIN_UNIT} restarted."
        ;;
      hailo)
        echo "==> Linking/cloning hailo-apps-infra into ${MILO_ROOT}/venv..."
        milo-doctor --heal >/dev/null 2>&1 || true
        systemctl restart "$MAIN_UNIT"
        echo "✓ Hailo Python environment linked and ${MAIN_UNIT} restarted."
        ;;
      db)
        echo "==> Running SQLite WAL checkpoint, integrity check, and VACUUM on ${DB}..."
        milo-backup --tag "pre-db-fix" >/dev/null 2>&1 || true
        systemctl stop "$MAIN_UNIT" 2>/dev/null || true
        sqlite3 "$DB" "PRAGMA wal_checkpoint(TRUNCATE); PRAGMA integrity_check; VACUUM;"
        chown "${SUDO_USER:-UKIRMA}": "$DB" 2>/dev/null || true
        systemctl start "$MAIN_UNIT" 2>/dev/null || true
        echo "✓ Database repaired and ${MAIN_UNIT} restarted."
        ;;
      reinstall)
        echo "==> Running full local repair install from ${MILO_ROOT}/current..."
        exec bash "${MILO_ROOT}/current/deploy/install.sh" --repair --source local --file "${MILO_ROOT}/current"
        ;;
      *)
        echo "Usage: sudo milo fix [all|mqtt|hailo|db|reinstall]" >&2
        exit 2
        ;;
    esac
    ;;

  db|database)
    SUB="${2:-tables}"
    if [[ ! -f "$DB" ]]; then
      echo "Database file not found at ${DB}" >&2
      exit 1
    fi
    case "$SUB" in
      tables|summary)
        echo "=== MILO Database: ${DB} ($(du -h "$DB" | cut -f1)) ==="
        for tbl in $(sqlite3 "$DB" "SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%' ORDER BY name;"); do
          cnt="$(sqlite3 "$DB" "SELECT COUNT(*) FROM \"${tbl}\";" 2>/dev/null || echo '?')"
          printf "  %-20s %s rows\n" "$tbl" "$cnt"
        done
        echo ""
        echo "--- Users (top 20) ---"
        sqlite3 -header -column "$DB" "SELECT code, name, department, status, account_type FROM users LIMIT 20;"
        echo ""
        echo "--- Recent Deposits (last 15) ---"
        sqlite3 -header -column "$DB" "SELECT id, user_code, material, points, machine_id, datetime(CAST(timestamp AS INTEGER), 'unixepoch', 'localtime') AS time FROM user_points ORDER BY id DESC LIMIT 15;"
        echo ""
        echo "Tip: view any table with 'milo db <table_name>' or run SQL with 'sudo milo db sql \"SELECT ...\"'"
        ;;
      sql)
        need_root db sql
        QUERY="${3:-}"
        [[ -n "$QUERY" ]] || { echo "Usage: sudo milo db sql \"SELECT * FROM users;\"" >&2; exit 2; }
        sqlite3 -header -column "$DB" "$QUERY"
        ;;
      shell|cli)
        need_root db shell
        exec sqlite3 -header -column "$DB"
        ;;
      *)
        TBL="$(tr -cd 'A-Za-z0-9_' <<<"$SUB")"
        echo "=== Table: ${TBL} (up to 100 rows) ==="
        sqlite3 -header -column "$DB" "SELECT * FROM \"${TBL}\" LIMIT 100;"
        ;;
    esac
    ;;

  camera|preview)
    need_root camera
    echo "==> Stopping ${MAIN_UNIT} temporarily to run interactive camera preview (Ctrl-C to stop)..."
    systemctl stop "$MAIN_UNIT" 2>/dev/null || true
    trap 'echo ""; echo "==> Restarting ${MAIN_UNIT}..."; systemctl start "$MAIN_UNIT" 2>/dev/null || true' EXIT
    export DISPLAY="${DISPLAY:-:0}"
    export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/1000}"
    export MILO_DEBUG_DETECT=1
    "${MILO_ROOT}/venv/bin/python" "${MILO_ROOT}/current/milo-detect.py" --input rpi --hef-path "${MILO_MODEL_PATH:-${MILO_ROOT}/models/milo.hef}"
    ;;

  logs)
    shift; FOLLOW="-f"; [[ "${1:-}" == "--no-follow" ]] && FOLLOW=""
    journalctl -u "$MAIN_UNIT" -n 100 $FOLLOW --no-pager
    ;;
  restart)
    need_root restart
    systemctl restart "$MAIN_UNIT" && echo "Restarted ${MAIN_UNIT}"
    ;;
  stop)    need_root stop;  systemctl stop "$MAIN_UNIT" && echo "Stopped" ;;
  start)   need_root start; systemctl start "$MAIN_UNIT" && echo "Started" ;;
  update)  need_root update;  exec milo-update "${@:2}" ;;
  rollback) need_root rollback; exec milo-update --rollback ;;
  backup)  need_root backup;  exec milo-backup "${@:2}" ;;
  restore) need_root restore; exec milo-backup --restore "${2:-}" ;;
  config)
    need_root config
    "${EDITOR:-nano}" "$CONFIG_FILE"
    echo "Restart to apply:  sudo milo restart"
    ;;
  ui)
    IP="$(hostname -I 2>/dev/null | awk '{print $1}')"
    echo "Repair UI: http://${IP:-<pi-ip>}:${MILO_UI_PORT:-8088}"
    echo "PIN:       ${MILO_UI_PIN:-<see ${CONFIG_FILE}>}  (or log in with Admin username/password)"
    ;;
  version)
    CUR_T="$(readlink -f "${MILO_ROOT}/current" 2>/dev/null || true)"
    [[ -n "$CUR_T" && -d "$CUR_T" ]] && CUR_V="$(basename "$CUR_T")" || CUR_V="not installed"
    echo "Release:  ${CUR_V}"
    echo "Machine:  ${MILO_MACHINE_ID:-?} (${MILO_MACHINE_NAME:-?})"
    echo "Role:     ${ROLE}"
    ;;
  help|--help|-h|*)
    cat <<EOF
MILO technician commands

  milo status                   is it running?
  milo doctor                   full health check (add --heal to auto-fix)
  sudo milo fix [target]        raw self-heal without UI: all | mqtt | hailo | db | reinstall
  milo db                       summary of all database tables, users, and recent deposits
  milo db <table>               view rows of a specific table (users, user_points, bins, etc.)
  sudo milo db sql "<query>"    run a raw SQL query on the database
  sudo milo db shell            open interactive SQLite shell
  sudo milo camera              launch live camera preview + debug detections in foreground
  milo logs                     live log output (Ctrl-C to stop)
  sudo milo restart             restart the application
  sudo milo update              check for and install updates
  sudo milo rollback            return to the previous version
  sudo milo backup              snapshot the database now
  sudo milo restore FILE        restore a snapshot
  sudo milo config              edit configuration file in terminal
  milo ui                       show the repair UI address and PIN

Full rebuild:  curl -fsSL ${MILO_SITE:-https://milo-robotics.org}/recovery/install.sh | sudo bash
EOF
    ;;
esac
